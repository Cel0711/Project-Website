# Copy to .env and edit. Never commit the real .env.

PORT=8787

# Comma-separated list of origins allowed to call this API.
# Use the Vite dev server origin locally, your real domain in production.
CORS_ORIGIN=http://localhost:5173

# Where quote requests are written. "json-file" needs no external service;
# swap in a real database adapter later without touching the routes.
STORAGE_DRIVER=json-file
DATA_DIR=./data

# Optional: address quote requests are addressed "for" in logs/notifications.
# The actual email address shown to visitors is CFG.email in the frontend.
NOTIFY_EMAIL=info@lablace.com

# Required to use GET /api/quotes and GET /api/quotes/:id (the owner inbox).
# Leave unset to keep those routes disabled. Generate with e.g.:
#   node -e "console.log(require('crypto').randomUUID())"
ADMIN_TOKEN=
