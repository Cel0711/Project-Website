# Copy to .env and edit. Never commit the real .env (it is git-ignored).

PORT=8787

# Public address of the website. Used for links inside emails and as an allowed Origin for form posts.
APP_URL=http://localhost:5173
# Extra origins allowed to call this API from another address (comma-separated). Leave empty when the site and
# the API share one address: Vite's proxy does that in dev, nginx in production.
CORS_ORIGIN=

# --- PostgreSQL ---
# Local dev: open the SSH tunnel first, in its own terminal, and leave it running:
#   ssh -N -L 5434:localhost:5432 <ssh-user>@<server>
# then point DATABASE_URL at the tunnel (127.0.0.1:5434). On the server itself use localhost:5432.
# URL-encode special characters in the password ("@" is %40). Use lablace_dev for development.
DATABASE_URL=postgresql://lab_user:<password>@127.0.0.1:5434/lablace_dev
# Optional: use a schema inside the database instead of "public" (for example dev or test).
DB_SCHEMA=
DB_SSL=false

# --- Sessions ---
SESSION_TTL_DAYS=14
# true in production behind HTTPS. Leave false for http://localhost.
COOKIE_SECURE=false

# --- Email (SMTP). Leave SMTP_HOST empty to run without email: ---
#   sign-ups are accepted without verification, and Forgot / Remind me tell people to contact you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lab-Lace IT Software & Solutions <info@lablace.com>"
# The shared team inbox that is emailed when a client sends a request or a message.
NOTIFY_EMAIL=info@lablace.com
COMPANY_NAME=Lab-Lace IT Software & Solutions

# --- First accounts, used once by `npm run db:seed -w packages/backend` ---
# Each seeded account must choose a new password at first sign-in. Leave a password empty to have one generated.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_FINANCE_EMAIL=
SEED_FINANCE_NAME=
SEED_FINANCE_PASSWORD=
