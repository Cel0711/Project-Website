# Template only. Copy to server.env (git-ignored) for your own notes; never commit real values.
# The backend itself reads packages/backend/.env (see .env.example), not this file.
# Prefer SSH keys over passwords; use a normal SSH user, not root.

SERVER_HOST=your.server.ip
SERVER_USER=your-ssh-user

# Local dev reaches the server's Postgres through an SSH tunnel. Leave it running in its own terminal:
#   ssh -N -L 5434:localhost:5432 your-ssh-user@your.server.ip
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=lablace_dev
DB_USER=lab_user
DB_PASSWORD=
# Same connection as one URL (URL-encode special characters in the password, "@" is %40):
DATABASE_URL=postgresql://lab_user:<url-encoded-password>@127.0.0.1:5434/lablace_dev
