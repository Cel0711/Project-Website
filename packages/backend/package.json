{
  "name": "@coreloop/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:demo": "tsx dev/demo-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:migrate:down": "tsx src/scripts/migrate.ts down",
    "db:status": "tsx src/scripts/migrate.ts status",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js up",
    "db:seed:prod": "node dist/scripts/seed.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@coreloop/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "node": "^26.12.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pm2": "^5.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}
