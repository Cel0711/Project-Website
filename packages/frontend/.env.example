# Copy to .env.local and edit. Vite only exposes variables prefixed VITE_.

# Leave this EMPTY. The browser then calls the API on the same address the page came from, which is what keeps
# the sign-in cookie working with no CORS setup: Vite proxies /api to the backend in development, and nginx does
# the same in production (see docs/PORTAL.md). Set it only if the API really lives on another address.
VITE_API_BASE_URL=

# Development only (read by vite.config.ts, not by the browser): where the Vite dev server forwards /api.
# The backend listens on 8787 by default.
# VITE_API_PROXY=http://localhost:8787
